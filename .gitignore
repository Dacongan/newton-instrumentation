# ==============================================================
#  newton-instrumentation
#  Low-cost instrumentation for a 130/650 Newtonian telescope
# ==============================================================
#
#  SECURITY FIRST. This project embeds WiFi credentials, may talk
#  to APIs and produces observation logs that contain your GPS
#  position and the hours you are away from home.
#
#  Rule of thumb: if it holds a password, a token or a location,
#  it does not belong in git. Ship a *.template instead.
# ==============================================================


# --------------------------------------------------------------
#  1. SECRETS AND CREDENTIALS
# --------------------------------------------------------------

# Firmware credentials — commit secrets.h.template instead
firmware/include/secrets.h
firmware/src/secrets.h
**/secrets.h
**/secrets.hpp
**/credentials.h
**/wifi_config.h

# Environment files
.env
.env.*
!.env.template
!.env.example
*.env

# Generic secret files
secrets.*
!secrets.*.template
!secrets.*.example
credentials.*
!credentials.*.template
config.local.*
settings.local.*
*.secret
*.private

# API keys and tokens
*apikey*
*api_key*
*.token
.netrc
.npmrc
.pypirc

# Keys and certificates
*.pem
*.key
*.crt
*.cer
*.der
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*
*.ppk
.ssh/

# Cloud provider credentials
.aws/
.azure/
.gcloud/
gcloud-*.json
service-account*.json


# --------------------------------------------------------------
#  2. LOCATION AND OBSERVATION PRIVACY
# --------------------------------------------------------------
#
#  Session logs record WHERE you observe and WHEN you are out.
#  Keep raw sessions local. Promote only curated campaigns,
#  with the site named generically — never exact coordinates.

logs/
**/logs/
raw-sessions/
*.log
!example.log

# Observation site configuration
site.json
site.yaml
location.*
observatory.json


# --------------------------------------------------------------
#  3. EMBEDDED / PLATFORMIO / ARDUINO
# --------------------------------------------------------------

.pio/
.pioenvs/
.piolibdeps/
.clang_complete
.gcc-flags.json
firmware/lib/
!firmware/lib/README
*.elf
*.hex
*.bin
!**/assets/**/*.bin
build/
.build/


