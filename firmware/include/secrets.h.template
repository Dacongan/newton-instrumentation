// =============================================================
//  secrets.h.template
// =============================================================
//  Copy to secrets.h and fill in. secrets.h is git-ignored and
//  must never be committed.
//
//      cp include/secrets.h.template include/secrets.h
//
//  These are the home-network credentials the ESP32 tries first.
//  If the network is not found within WIFI_TIMEOUT_MS it brings
//  up its own access point instead — see config.h. Out in the
//  field there is no router, so the AP fallback is the normal
//  case, not the exception.
// =============================================================

#pragma once

#define WIFI_STA_SSID      "your-home-network"
#define WIFI_STA_PASSWORD  "your-password"

// Access point the ESP32 raises when the network above is absent.
// WPA2 needs at least 8 characters.
#define WIFI_AP_SSID       "newton-scope"
#define WIFI_AP_PASSWORD   "change-me"
